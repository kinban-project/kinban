# KINBAN HTTP MCP endpoint (public example: https://your-kinban.example/api/mcp).
# The local seed database uses http://localhost:3003/mcp.
KINBAN_MCP_URL=http://localhost:3003/mcp

# LOCAL SEED ONLY: fixed assistant key for scripts/seed-local.sql.
# It is intentionally public and must never be used for a deployed database.
# Replace this value immediately for any non-local environment.
KINBAN_ASSISTANT_API_KEY=mcp_local_seed_kinban_demo_2026_only

# Local seed group. The assistant must not access another group.
KINBAN_GROUP_ID=seed-group-store

KINBAN_TIMEZONE=Asia/Tokyo
