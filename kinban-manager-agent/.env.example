# KINBAN HTTP MCP endpoint (public example: https://your-kinban.example/api/mcp).
# Local development uses http://localhost:3001/mcp.
KINBAN_MCP_URL=

# Group-scoped assistant key. Never commit the actual value.
KINBAN_ASSISTANT_API_KEY=

# Target KINBAN group ID. The assistant must not access another group.
KINBAN_GROUP_ID=

KINBAN_TIMEZONE=Asia/Tokyo
