{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kinban-prod",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-08-04",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "kinban-prod-db",
      "database_id": "dcae8d84-d3b5-48f1-99f4-9f223fdb5af2",
      "migrations_dir": "drizzle"
    }
  ],
  "r2_buckets": [
    {
      "binding": "FILES",
      "bucket_name": "kinban-prod-files"
    }
  ]
}
