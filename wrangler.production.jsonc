{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kinban-prod",
  "main": "./dist/server/index.js",
  "keep_vars": true,
  "compatibility_date": "2026-08-04",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "DEMO_MODE": "true",
    "DEMO_DEFAULT_USER_ID": "tanaka",
    "NEXT_PUBLIC_DEMO_MODE": "true",
    "NEXT_PUBLIC_DEMO_DEFAULT_USER_ID": "tanaka",
    "PUBLIC_APP_URL": "https://kinban-prod.kinban.workers.dev"
  },
  "assets": {
    "directory": "./dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "kinban-prod-db",
      "database_id": "dcae8d84-d3b5-48f1-99f4-9f223fdb5af2",
      "migrations_dir": "drizzle"
    }
  ],
  "r2_buckets": [
    {
      "binding": "FILES",
      "bucket_name": "kinban-prod-files"
    }
  ]
}
