# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.vinext/
/out/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
next-env.d.ts
/dist/
/.wrangler/
/outputs/
/work/
/pet_runs/
/tmp/

# Local runtime and review artifacts
*.log
/.codex-remote-attachments/
/_kinban_review/

# QA screenshots are kept locally; scenario scripts and reports remain tracked.
/qa/**/evidence/
/qa/acceptance-2026-07-19/phone-issue77-*.png
/qa/acceptance-2026-07-19/mobile-new-surfaces-2026-07-27.md
/qa/nightclub-3month-2026-07-30/

# MCP acceptance transcripts can include one-time API keys. Keep the scenario
# script and its report, but never commit the generated raw transcript.
/qa/acceptance-2026-07-19/logs/mcp-scenarios.jsonl

# Local archives and TypeScript build metadata.
/kinban-*.tar.gz
*.tsbuildinfo

# Separate reference materials kept outside this application repository
/docs/
/assets/
/screenshots/

# Local runtime state for the PC-resident KINBAN operations assistant.
/kinban-manager-agent/.env
/kinban-manager-agent/workspace/*
!/kinban-manager-agent/workspace/README.md

# Separate landing page project; not part of the KINBAN application repository.
/landing/
qa/shift-evaluation/runs/
