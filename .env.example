# Demo mode enables the seeded demo data and simplified user switching.
# Set both DEMO_MODE values to true only for a demo deployment that uses the
# demo seed data.
DEMO_MODE=false
DEMO_DEFAULT_USER_ID=tanaka
NEXT_PUBLIC_DEMO_MODE=false
NEXT_PUBLIC_DEMO_DEFAULT_USER_ID=tanaka

# Local member AI assist runtime. Leave empty to hide/disable the handoff in a deployed environment.
KINBAN_AGENT_RUNTIME_URL=http://localhost:8000

# Web Push (deploy environment only). Generate once with: npm run push:generate-vapid
VAPID_SUBJECT=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Production site access bootstrap. Set these as Cloudflare secrets only.
# The first matching ChatGPT identity becomes the site administrator once.
INITIAL_OWNER_EMAIL=
INITIAL_SETUP_SECRET=

# Google OAuth (local: http://localhost:3003/auth/google/callback)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3003/auth/google/callback
RESEND_API_KEY=
RESEND_FROM_EMAIL=KINBAN通知 <notification@send.kinban.jp>
RESEND_REPLY_TO=info@kinban.jp
PUBLIC_APP_URL=http://localhost:3003
